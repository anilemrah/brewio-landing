---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Home from '../../components/home/Home.astro';
import Footer from '../../components/Footer.astro';
import { SITE_URL, APP_STORE_URL, ORGANIZATION } from '../../data/site';
import locales from '../../data/i18n/locales.json';
import home from '../../data/i18n/home.json';
import { pagesFor } from '../../data/i18n/native-pages';

export function getStaticPaths() {
  return Object.keys(locales).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const meta = (locales as Record<string, any>)[locale!].meta;
const t = (home as Record<string, any>)[locale!];

const canonicalUrl = `${SITE_URL}/${locale}/`;
// Guides and calculators written natively for this language.
const pages = pagesFor(locale!).map((p) => ({ href: `/${locale}/${p.slug}/`, title: p.label, desc: p.description }));

const schema = [
  {
    '@type': 'MobileApplication',
    name: 'Brewio',
    description: t.seo.desc,
    url: canonicalUrl,
    downloadUrl: APP_STORE_URL,
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'iOS',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: ORGANIZATION,
    inLanguage: meta.hreflang,
    availableLanguage: Object.values(locales).map((l: any) => l.meta.hreflang).concat('en'),
  },
  ORGANIZATION,
];
---

<Layout
  title={t.seo.title}
  description={t.seo.desc}
  canonicalUrl={canonicalUrl}
  lang={meta.hreflang}
  ogLocale={meta.ogLocale}
  hreflangCluster
  schema={schema}
>
  <Nav locale={locale} />
  <Home t={t} shots={`/app/${locale}`} pages={pages} />
  <Footer locale={locale} />
</Layout>
