---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { TOOLS } from '../../data/tools';
import { BREW_METHODS } from '../../data/brewMethods';
import { SITE_URL, ORGANIZATION } from '../../data/site';

const schema = [
  {
    '@type': 'CollectionPage',
    name: 'Free Coffee Brewing Tools',
    description: 'Free coffee calculators and timers: brew ratio, grind size, extraction yield, and step-by-step brew timers for 12 methods.',
    url: `${SITE_URL}/tools/`,
    publisher: ORGANIZATION,
    inLanguage: 'en',
  },
  {
    '@type': 'ItemList',
    itemListElement: TOOLS.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.title,
      url: `${SITE_URL}/tools/${t.slug}/`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE_URL}/tools/` },
    ],
  },
];
---

<Layout
  title="Free coffee tools: ratio calculator, grind chart and brew timer | Brewio"
  description="Free coffee brewing tools: a coffee-to-water ratio calculator for 12 methods, a grind size chart, an extraction yield (EY%) calculator and step-by-step brew timers. No sign-up, no ads."
  schema={schema}
>
  <Nav />

  <main class="page">
    <header class="head">
      <h1>Free coffee calculators and timers</h1>
      <p>
        The ratio calculator, grind chart, extraction yield calculator and brew timer from the Brewio app,
        working in your browser. No sign-up and no ads.
      </p>
    </header>

    <div class="inner">
      <ul class="grid">
        {TOOLS.map((t) => (
          <li>
            <a href={`/tools/${t.slug}/`} class="card">
              <span class="card-icon" set:html={t.icon}></span>
              <h2 class="card-title">{t.title}</h2>
              <p class="card-desc">{t.desc}</p>
              <span class="card-link">Open</span>
            </a>
          </li>
        ))}
      </ul>

      <section class="methods">
        <h2 class="methods-heading">Ratios for {BREW_METHODS.length} brew methods</h2>
        <ul class="methods-list">
          {BREW_METHODS.map((m) => (
            <li>{m.name} <span class="m-ratio">1:{m.defaultRatio}</span></li>
          ))}
        </ul>
        <p class="methods-note">
          Including Ibrik / Cezve and Freddo Espresso, which most brewing apps leave out.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page { background: var(--paper); color: var(--ink); padding-bottom: 6rem; }

  .head, .inner { max-width: 900px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; }
  .head { padding-top: calc(64px + 4.5rem); padding-bottom: 3rem; }

  .head h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.3rem, 4.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .head p { margin-top: 1.25rem; max-width: 38rem; font-size: 1.1rem; line-height: 1.7; color: var(--ink-2); }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    transition: border-color 0.15s;
  }

  .card:hover { border-color: var(--ink-3); }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .card-icon { display: block; width: 26px; height: 26px; color: var(--accent-ink); margin-bottom: 0.25rem; }
  .card-icon :global(svg) { width: 100%; height: 100%; }

  .card-title { font-family: var(--font-serif); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.01em; }
  .card-desc { font-size: 0.95rem; line-height: 1.65; color: var(--ink-2); flex: 1; }
  .card-link { font-weight: 500; font-size: 0.95rem; color: var(--accent-ink); margin-top: 0.4rem; }

  .methods { margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--line); }

  .methods-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    margin-bottom: 1.25rem;
  }

  .methods-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.5rem 1.5rem;
  }

  .methods-list li {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    color: var(--ink);
  }

  .m-ratio { margin-left: auto; font-size: 0.9rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  .methods-note { font-size: 0.95rem; color: var(--ink-2); line-height: 1.7; margin-top: 1.5rem; max-width: 36rem; }

  @media (max-width: 700px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 640px) {
    .head, .inner { padding-left: 1rem; padding-right: 1rem; }
    .head { padding-top: calc(64px + 2.5rem); }
    .card { padding: 1.35rem; border-radius: 14px; }
  }
</style>
