---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { GUIDES } from '../data/guides';

const suggestions = GUIDES.slice(0, 4);
---

<Layout
  title="Page not found | Brewio"
  description="That page doesn't exist. Browse the Brewio coffee guides or the specialty roaster list instead."
  noindex
>
  <Nav />

  <main class="nf">
    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1 class="nf-headline">There's no page here</h1>
      <p class="nf-sub">
        It may have moved, or the link may be wrong. These are the pages most people look for.
      </p>

      <div class="nf-actions">
        <a href="/" class="nf-btn nf-btn-primary">Go to the homepage</a>
        <a href="/guides/" class="nf-btn">Guides</a>
        <a href="/roasters/" class="nf-btn">Roasters</a>
      </div>

      <ul class="nf-list">
        {suggestions.map((g) => (
          <li>
            <a href={`/guides/${g.slug}/`}>
              <span class="nf-list-title">{g.title}</span>
              <span class="nf-list-meta">{g.category} · {g.readTime} read</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .nf { background: var(--paper); color: var(--ink); padding: calc(64px + 5rem) 1.5rem 7rem; }
  .nf-inner { max-width: 720px; margin: 0 auto; }

  .nf-code { font-size: 0.95rem; color: var(--ink-3); margin-bottom: 0.75rem; }

  .nf-headline {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.3rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .nf-sub { margin-top: 1rem; font-size: 1.1rem; line-height: 1.7; color: var(--ink-2); max-width: 34rem; }

  .nf-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 2rem 0 3rem; }

  .nf-btn {
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.6rem 1.1rem;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    transition: border-color 0.15s;
  }

  .nf-btn:hover { border-color: var(--ink-3); }
  .nf-btn-primary { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .nf-btn-primary:hover { opacity: 0.88; }

  .nf-list { list-style: none; border-top: 1px solid var(--line); }

  .nf-list a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .nf-list a:hover .nf-list-title { color: var(--accent-ink); }
  .nf-list-title { font-weight: 600; font-size: 1.02rem; }
  .nf-list-meta { font-size: 0.88rem; color: var(--ink-3); }

  @media (max-width: 640px) {
    .nf { padding: calc(64px + 3rem) 1rem 5rem; }
  }
</style>
