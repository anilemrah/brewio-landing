    <span>30 g</span>
    <span>510 ml</span>
    <div class="rt-bar"><div class="rt-fill" style="width: 45%"></div></div>
  </div>
  <div class="rt-row">
    <span class="rt-method">French Press</span>
    <span class="rt-ratio">1:12</span>
    <span>30 g</span>
    <span>360 ml</span>
    <div class="rt-bar"><div class="rt-fill" style="width: 68%"></div></div>
  </div>
  <div class="rt-row">
    <span class="rt-method">AeroPress</span>
    <span class="rt-ratio">1:14</span>
    <span>17 g</span>
    <span>238 ml</span>
    <div class="rt-bar"><div class="rt-fill" style="width: 58%"></div></div>
  </div>
  <div class="rt-row">
    <span class="rt-method">Espresso</span>
    <span class="rt-ratio">1:2.5</span>
    <span>18 g</span>
    <span>45 ml</span>
    <div class="rt-bar"><div class="rt-fill" style="width: 95%"></div></div>
  </div>
  <div class="rt-row">
    <span class="rt-method">Cold Brew</span>
    <span class="rt-ratio">1:8</span>
    <span>100 g</span>
    <span>800 ml</span>
    <div class="rt-bar"><div class="rt-fill" style="width: 80%"></div></div>
  </div>
  <div class="rt-row">
    <span class="rt-method">Moka Pot</span>
    <span class="rt-ratio">1:7</span>
    <span>20 g</span>
    <span>140 ml</span>
    <div class="rt-bar"><div class="rt-fill" style="width: 85%"></div></div>
  </div>
  <div class="rt-row">
    <span class="rt-method">Drip Machine</span>
