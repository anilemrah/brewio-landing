---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { GUIDES } from '../../data/guides';
import { NATIVE_PAGES } from '../../data/i18n/native-pages';
import locales from '../../data/i18n/locales.json';

const guides = GUIDES;

// Pages written natively for one language, grouped by language. This is their main
// way in from the English site, since each language has only one or two of them.
const all = locales as Record<string, any>;
const byLocale = Object.keys(all)
  .map((code) => ({
    code,
    native: all[code].meta.native,
    pages: NATIVE_PAGES.filter((p) => p.locale === code).map((p) => ({ ...p, lang: p.lang ?? all[code].meta.hreflang })),
  }))
  .filter((l) => l.pages.length > 0);
---

<Layout
  title="Coffee guides and brewing tips | Brewio"
  description="Coffee guides: brew ratios, pour-over technique, tasting notes, AeroPress recipes and extraction, written to help you brew better coffee at home."
>
  <Nav />

  <main class="page">
    <header class="head">
      <h1>Coffee guides</h1>
      <p>
        How to brew with different methods, how to taste, and what the numbers mean, from ratios and grind size to
        extraction yield. Free to read.
      </p>
    </header>

    <div class="inner">
      <ul class="list">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.slug}/`} class="guide">
              <span class="guide-icon" set:html={g.icon}></span>
              <span class="guide-text">
                <span class="guide-title">{g.title}</span>
                <span class="guide-desc">{g.desc}</span>
              </span>
              <span class="guide-meta">{g.category}<br />{g.readTime} read</span>
            </a>
          </li>
        ))}
      </ul>

      <section class="native" aria-labelledby="native-heading">
        <h2 id="native-heading" class="native-heading">Guides in other languages</h2>
        <p class="native-intro">
          Written for coffee drinkers in each country, in their own units and with their own brewers, not translated
          from the English guides.
        </p>
        <ul class="native-list">
          {byLocale.map((l) => (
            <li class="native-lang">
              <span class="native-name">{l.native}</span>
              <span class="native-pages">
                {l.pages.map((p) => (
                  <a href={`/${p.locale}/${p.slug}/`} hreflang={p.lang} lang={p.lang}>{p.label}</a>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page { background: var(--paper); color: var(--ink); padding-bottom: 6rem; }

  .head, .inner { max-width: 900px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; }
  .head { padding-top: calc(64px + 4.5rem); padding-bottom: 2.5rem; }

  .head h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.3rem, 4.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.022em;
  }

  .head p { margin-top: 1.25rem; max-width: 38rem; font-size: 1.1rem; line-height: 1.7; color: var(--ink-2); }

  .list { list-style: none; border-top: 1px solid var(--line); }

  .guide {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: start;
    padding: 1.5rem 0.25rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.15s;
  }

  .guide:hover { background: var(--surface); }
  .guide:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .guide-icon { display: block; width: 26px; height: 26px; margin-top: 0.15rem; color: var(--accent-ink); }
  .guide-icon :global(svg) { width: 100%; height: 100%; }

  .guide-text { display: flex; flex-direction: column; gap: 0.35rem; }
  .guide-title { font-family: var(--font-serif); font-weight: 600; font-size: 1.3rem; line-height: 1.25; letter-spacing: -0.01em; }
  .guide-desc { font-size: 0.97rem; line-height: 1.6; color: var(--ink-2); }
  .guide-meta { font-size: 0.85rem; line-height: 1.6; color: var(--ink-3); text-align: right; white-space: nowrap; }

  .native { margin-top: 4rem; }
  .native-heading { font-family: var(--font-serif); font-weight: 600; font-size: 1.6rem; letter-spacing: -0.015em; }
  .native-intro { margin-top: 0.6rem; max-width: 38rem; font-size: 0.97rem; line-height: 1.6; color: var(--ink-2); }
  .native-list { list-style: none; margin-top: 1.5rem; border-top: 1px solid var(--line); }
  .native-lang {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .native-name { font-size: 0.85rem; color: var(--ink-3); padding-top: 0.1rem; }
  .native-pages { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; }
  .native-pages a { font-size: 0.97rem; line-height: 1.5; color: var(--ink); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .native-pages a:hover { text-decoration-color: var(--ink-3); }
  .native-pages a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 640px) {
    .native-lang { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; }
    .head, .inner { padding-left: 1rem; padding-right: 1rem; }
    .head { padding-top: calc(64px + 2.5rem); }
    .guide { grid-template-columns: 24px minmax(0, 1fr); }
    .guide-meta { grid-column: 2; text-align: left; white-space: normal; }
  }
</style>
