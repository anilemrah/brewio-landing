---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import allRoasters from '../data/roasters.json';
import { APP_STORE_URL } from '../data/site';

// The same roaster list as the app; `featured` is the roaster the app promotes too.
const featured = allRoasters.find(r => r.featured);
const countryName = new Intl.DisplayNames(['en'], { type: 'region' });

const GROUPS: { name: string; countries: string[] }[] = [
  { name: 'Nordic countries', countries: ['SE', 'NO', 'DK', 'FI', 'IS'] },
  { name: 'Rest of Europe', countries: ['DE', 'GB', 'NL', 'FR', 'IT', 'ES', 'PT', 'GR', 'BE', 'IE', 'AT', 'CH'] },
  { name: 'Turkey', countries: ['TR'] },
  { name: 'Japan', countries: ['JP'] },
  { name: 'South Korea', countries: ['KR'] },
  { name: 'The Americas', countries: ['US', 'CA', 'MX', 'CO', 'BR'] },
  { name: 'Australia', countries: ['AU', 'NZ'] },
];
const grouped = new Set(GROUPS.flatMap(g => g.countries));
const groups = [...GROUPS, { name: 'Elsewhere', countries: [...new Set(allRoasters.map(r => r.country))].filter(c => !grouped.has(c)) }]
  .map(g => ({ name: g.name, roasters: allRoasters.filter(r => r !== featured && g.countries.includes(r.country)) }))
  .filter(g => g.roasters.length > 0);

const SHIPS: Record<string, string> = { worldwide: 'Ships worldwide', EU: 'Ships to the EU', regional: 'Ships locally' };
---

<Layout
  title="Specialty coffee roasters we recommend | Brewio"
  description={`${allRoasters.length} specialty coffee roasters from Europe, Japan, South Korea, the Americas and Australia, with what they focus on and where they ship. Nobody pays to be listed.`}
>
  <Nav />

  <main class="page">
    <header class="head wrap">
      <h1>Specialty roasters we recommend</h1>
      <p>
        {allRoasters.length} roasters we like, from small Swedish roasteries to Tokyo and Seoul. The same list is in
        the Brewio app. Brewio has no deals with any of them: nobody pays to be listed and we earn nothing when you buy.
      </p>
    </header>

    {featured && (
      <section class="rotm wrap">
        <p class="label">Roastery of the month</p>
        <div class="rotm-card">
          {featured.banner && (
            <img src={featured.banner} alt={featured.name} class="rotm-banner" loading="lazy" />
          )}
          <div class="rotm-body">
            <div class="rotm-name-row">
              {featured.logo && <img src={featured.logo} alt="" class="logo logo-lg" loading="lazy" />}
              <div>
                <h2>{featured.name}</h2>
                <p class="where">{featured.city}, {countryName.of(featured.country)}</p>
              </div>
            </div>
            <p class="rotm-desc">{featured.description}</p>
            {featured.quote && <p class="rotm-quote">{featured.quote}</p>}
            <div class="tags">
              {featured.focus.map(f => <span class="tag">{f}</span>)}
              <span class="tag">{SHIPS[featured.ships] ?? featured.ships}</span>
            </div>
            <a href={featured.website} class="text-link" target="_blank" rel="noopener">Visit {featured.name}</a>
          </div>
        </div>
      </section>
    )}

    <div class="groups wrap">
      {groups.map(g => (
        <section class="group">
          <h2>{g.name}</h2>
          <div class="grid">
            {g.roasters.map(r => (
              <a href={r.website} class="card" target="_blank" rel="noopener">
                <div class="card-top">
                  {r.logo
                    ? <img src={r.logo} alt="" class="logo" width="48" height="48" loading="lazy" />
                    : <span class="logo logo-letter">{r.name.charAt(0)}</span>}
                  <div class="card-name">
                    <h3>{r.name}</h3>
                    <p class="where">{r.city}</p>
                  </div>
                </div>
                <p class="card-quote">{r.quote || r.description}</p>
                <p class="card-meta">{[...r.focus, SHIPS[r.ships] ?? r.ships].join(' · ')}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="cta wrap">
      <h2>Find one that ships to you</h2>
      <p>In the app, Discover can show only the roasters that ship to where you live.</p>
      <a href={APP_STORE_URL} class="store" target="_blank" rel="noopener">
        <img src="/badge-app-store.svg" alt="Download on the App Store" width="156" height="52" />
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page { background: var(--paper); color: var(--ink); }

  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }

  h1, h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .head { padding-top: calc(64px + 4.5rem); padding-bottom: 3.5rem; }
  .head h1 { font-size: clamp(2.3rem, 4.6vw, 3.6rem); line-height: 1.06; letter-spacing: -0.022em; max-width: 16ch; }
  .head p { margin-top: 1.25rem; max-width: 40rem; font-size: 1.1rem; line-height: 1.7; color: var(--ink-2); }

  .label { font-size: 0.92rem; font-weight: 600; color: var(--accent-ink); margin-bottom: 0.85rem; }

  .rotm-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }

  .rotm-banner { width: 100%; height: 100%; min-height: 320px; object-fit: cover; display: block; }
  .rotm-body { padding: 2rem 2.25rem 2.25rem; }

  .rotm-name-row { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 1.1rem; }
  .rotm-name-row h2 { font-size: 1.75rem; line-height: 1.15; }

  .rotm-desc { font-size: 1rem; line-height: 1.7; color: var(--ink-2); }
  .rotm-quote { margin-top: 0.9rem; font-size: 1rem; line-height: 1.6; color: var(--ink); }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.25rem 0 1.4rem; }
  .tag { font-size: 0.82rem; padding: 0.25rem 0.65rem; border: 1px solid var(--line); border-radius: 100px; color: var(--ink-2); }

  .text-link { font-weight: 500; color: var(--accent-ink); border-bottom: 1px solid currentColor; padding-bottom: 1px; }
  .text-link:hover { color: var(--ink); }

  .logo {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 11px;
    background: #fff;
    border: 1px solid var(--line);
    object-fit: contain;
  }

  .logo-lg { width: 60px; height: 60px; border-radius: 14px; }

  .logo-letter {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--accent-ink);
  }

  .where { font-size: 0.9rem; color: var(--ink-3); }

  .groups { padding-top: 5rem; }
  .group + .group { margin-top: 4rem; }
  .group h2 { font-size: 1.6rem; margin-bottom: 1.25rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.15s;
  }

  .card:hover { border-color: var(--ink-3); }
  .card-top { display: flex; align-items: center; gap: 0.8rem; }
  .card-name { min-width: 0; }
  .card h3 { font-size: 1.02rem; font-weight: 600; line-height: 1.3; }
  .card-quote { font-size: 0.93rem; line-height: 1.6; color: var(--ink-2); flex: 1; }
  .card-meta { font-size: 0.82rem; color: var(--ink-3); }

  .cta { padding-top: 6rem; padding-bottom: 7rem; }
  .cta h2 { font-size: clamp(1.9rem, 3vw, 2.4rem); }
  .cta p { margin: 0.9rem 0 1.75rem; max-width: 34rem; font-size: 1.05rem; line-height: 1.7; color: var(--ink-2); }
  .store img { display: block; height: 52px; width: auto; }

  @media (max-width: 960px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rotm-card { grid-template-columns: minmax(0, 1fr); }
    .rotm-banner { min-height: 0; aspect-ratio: 16 / 9; height: auto; }
  }

  @media (max-width: 640px) {
    .wrap { padding: 0 1rem; }
    .head { padding-top: calc(64px + 2.5rem); }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .rotm-body { padding: 1.5rem; }
    .groups { padding-top: 3.5rem; }
    .cta { padding-top: 4.5rem; padding-bottom: 5rem; }
  }
</style>
