---
import LangSwitcher from './LangSwitcher.astro';
import { APP_STORE_URL } from '../data/site';
import home from '../data/i18n/home.json';

interface Props {
  /** Set on the localized homepages: links point at that page's sections, labels are translated. */
  locale?: string;
}

const { locale } = Astro.props;
const t = (home as Record<string, any>)[locale ?? 'en'].nav;
const base = locale ? `/${locale}/` : '/';

const links = locale
  ? [
      { href: `${base}#features`, label: t.features },
      { href: `${base}#pricing`, label: t.pricing },
      { href: `${base}#faq`, label: t.faq },
      { href: '/roasters/', label: t.roasters },
    ]
  : [
      { href: '/#features', label: t.features },
      { href: '/#pricing', label: t.pricing },
      { href: '/roasters/', label: t.roasters },
      { href: '/guides/', label: t.guides },
      { href: '/tools/', label: t.tools },
    ];
---

<header class="nav">
  <div class="nav-inner">
    <a href={base} class="logo">
      <img src="/app/icon.png" alt="" width="30" height="30" />
      <span>Brewio</span>
    </a>

    <nav class="nav-links" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <LangSwitcher current={locale ?? 'en'} light />

    <a href={APP_STORE_URL} class="nav-cta" target="_blank" rel="noopener">{t.get}</a>

    <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="mobile-menu">{t.menu}</button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Main" hidden>
    {links.map((l) => <a href={l.href} data-close>{l.label}</a>)}
    <a href={APP_STORE_URL} class="mobile-cta" target="_blank" rel="noopener">{t.get}</a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(250, 247, 242, 0.96);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    max-width: 1120px;
    height: 64px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .logo img { border-radius: 7px; }

  .nav-links { display: flex; gap: 1.75rem; }

  .nav-links a {
    font-size: 0.95rem;
    color: var(--ink-2);
    transition: color 0.15s;
  }

  .nav-links a:hover { color: var(--ink); }

  .nav-cta {
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: var(--ink);
    color: var(--paper);
    transition: opacity 0.15s;
  }

  .nav-cta:hover { opacity: 0.85; }

  .menu-btn {
    display: none;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem 1.25rem;
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .mobile-menu[hidden] { display: none; }

  .mobile-menu a {
    padding: 0.85rem 0;
    font-size: 1.05rem;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu .mobile-cta {
    margin-top: 1rem;
    border: 0;
    border-radius: 10px;
    background: var(--ink);
    color: var(--paper);
    text-align: center;
    font-weight: 500;
  }

  @media (max-width: 980px) {
    .nav-links a:nth-child(n+4) { display: none; }
  }

  @media (max-width: 760px) {
    .nav-inner { padding: 0 1rem; gap: 0.75rem; }
    .nav-links, .nav-cta { display: none; }
    .menu-btn { display: block; }
  }
</style>

<script>
  const button = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    if (!button || !menu) return;
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
  }

  button?.addEventListener('click', () => setOpen(menu?.hidden ?? false));
  menu?.querySelectorAll('[data-close]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>
