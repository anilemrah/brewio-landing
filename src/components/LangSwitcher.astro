---
import locales from '../data/i18n/locales.json';

interface Props {
  /** Current locale code, or 'en' for the English site. */
  current: string;
  /** Render for a light background instead of the dark hero. */
  light?: boolean;
}

const { current, light = false } = Astro.props;

const options = [
  { code: 'en', native: 'English', href: '/' },
  ...Object.entries(locales as Record<string, any>).map(([code, l]) => ({
    code,
    native: l.meta.native,
    href: `/${code}/`,
  })),
];

const active = options.find((o) => o.code === current) ?? options[0];
---

<div class={`lang ${light ? 'lang-light' : ''}`}>
  <label class="sr-only" for="lang-select">Language</label>
  <svg class="lang-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/></svg>
  <select id="lang-select" class="lang-select">
    {options.map((o) => (
      <option value={o.href} selected={o.code === active.code}>{o.native}</option>
    ))}
  </select>
</div>

<script>
  document.querySelectorAll<HTMLSelectElement>('.lang-select').forEach((sel) => {
    sel.addEventListener('change', () => {
      if (sel.value) window.location.href = sel.value;
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem 0.35rem 0.8rem;
    border: 1px solid var(--border-dark);
    border-radius: 100px;
    color: rgba(250,247,242,0.7);
    transition: border-color 0.2s, color 0.2s;
  }

  .lang:hover { border-color: var(--text-muted); color: var(--cream); }

  .lang-light {
    border-color: var(--border);
    color: var(--text-muted);
  }

  .lang-light:hover { border-color: var(--amber); color: var(--text-dark); }

  .lang-icon { width: 15px; height: 15px; flex-shrink: 0; }

  .lang-select {
    appearance: none;
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    color: inherit;
    cursor: pointer;
    padding: 0 0.2rem;
  }

  .lang-select:focus { outline: none; }
  .lang:focus-within { outline: 2px solid var(--amber); outline-offset: 2px; }

  /* The dropdown itself renders in the OS palette — force readable options. */
  .lang-select option { color: #1A1714; background: #FAF7F2; }
</style>
