---
import Phone from './Phone.astro';
import Feature from './Feature.astro';
import { phrased } from './phrase';
import roasters from '../../data/roasters.json';
import { GUIDES } from '../../data/guides';
import { APP_STORE_URL } from '../../data/site';

interface Props {
  /** The page's strings: one language from data/i18n/home.json. */
  t: any;
  /** Folder with the app screenshots in this language. */
  shots?: string;
  /** Guides and calculators written for this language; the English guides when left out. */
  pages?: { href: string; title: string; desc: string }[];
}

const { t, shots = '/app', pages } = Astro.props;
const guides = pages ?? ['coffee-to-water-ratio', 'how-to-brew-v60', 'coffee-grind-size-chart']
  .map((slug) => GUIDES.find((g) => g.slug === slug)!)
  .map((g) => ({ href: `/guides/${g.slug}/`, title: g.title, desc: g.readTime }));
---

<main class="home">
  <section class="hero wrap">
    <div class="hero-text">
      <h1 set:html={phrased(t.hero.title)} />
      <p class="hero-sub">{t.hero.sub}</p>
      <a href={APP_STORE_URL} class="store" target="_blank" rel="noopener">
        <img src="/badge-app-store.svg" alt="Download on the App Store" width="156" height="52" />
      </a>
      <p class="hero-note">{t.hero.note}</p>
    </div>
    <div class="hero-media">
      <Phone src={`${shots}/journal.webp`} alt={t.hero.altJournal} class="hero-back" eager />
      <Phone src={`${shots}/home.webp`} alt={t.hero.altHome} class="hero-front" eager />
    </div>
  </section>

  <div class="features wrap" id="features">
    <Feature title={t.journal.title} body={t.journal.body} points={t.journal.points}>
      <Phone src={`${shots}/entry.webp`} alt={t.journal.alt} class="one" />
    </Feature>

    <Feature title={t.timer.title} body={t.timer.body} points={t.timer.points} reverse>
      <Phone src={`${shots}/timer.webp`} alt={t.timer.alt} class="one" />
    </Feature>

    <Feature title={t.stash.title} body={t.stash.body} points={t.stash.points}>
      <Phone src={`${shots}/stash.webp`} alt={t.stash.alt} class="one" />
    </Feature>

    <Feature title={t.taste.title} body={t.taste.body} note={t.taste.note} reverse>
      <Phone src={`${shots}/taste.webp`} alt={t.taste.altTaste} class="two" />
      <Phone src={`${shots}/recap.webp`} alt={t.taste.altRecap} class="two two-low" />
    </Feature>
  </div>

  <div class="band">
    <div class="wrap">
      <Feature title={t.beanie.title} body={t.beanie.body} note={t.beanie.note}>
        <Phone src={`${shots}/wardrobe.webp`} alt={t.beanie.altWardrobe} class="two" />
        <Phone src={`${shots}/stickers.webp`} alt={t.beanie.altStickers} class="two two-low" />
      </Feature>
    </div>
  </div>

  <section class="roasters wrap" id="roasters">
    <div class="section-head">
      <h2 set:html={phrased(t.roasters.title)} />
      <p>{t.roasters.body.replace('{count}', String(roasters.length))}</p>
      <a href="/roasters/" class="text-link">{t.roasters.link}</a>
    </div>
    <a href="/roasters/" class="logo-wall" aria-label={t.roasters.link}>
      {roasters.filter((r) => r.logo).map((r) => (
        <img src={r.logo} alt={r.name} title={r.name} width="56" height="56" loading="lazy" decoding="async" />
      ))}
    </a>
  </section>

  <section class="more wrap">
    <h2 set:html={phrased(t.more.title)} />
    <div class="more-grid">
      {t.more.items.map((item: { title: string; body: string }) => (
        <div class="more-item">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="pricing wrap" id="pricing">
    <h2 set:html={phrased(t.pricing.title)} />
    <div class="plans">
      {[t.pricing.free, t.pricing.pro].map((plan: { name: string; sub: string; points: string[] }, i: number) => (
        <div class={`plan ${i === 1 ? 'plan-pro' : ''}`}>
          <h3>{plan.name}</h3>
          <p class="plan-sub">{plan.sub}</p>
          <ul>
            {plan.points.map((p) => (
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="pricing-note">{t.pricing.note}</p>
  </section>

  <section class="faq wrap" id="faq">
    <h2 set:html={phrased(t.faq.title)} />
    <div class="faq-list">
      {t.faq.items.map((item: { q: string; a: string }) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="guides wrap">
    <div class="section-head">
      <h2 set:html={phrased(t.guides.title)} />
      <p>{t.guides.body}</p>
    </div>
    <div class="guide-list">
      {guides.map((g) => (
        <a href={g.href} class="guide">
          <span class="guide-title">{g.title}</span>
          <span class="guide-time">{g.desc}</span>
        </a>
      ))}
    </div>
    {!pages && (
      <div class="guide-links">
        <a href="/guides/" class="text-link">{t.guides.all}</a>
        <a href="/tools/" class="text-link">{t.guides.tools}</a>
      </div>
    )}
  </section>

  <section class="cta wrap" id="download">
    <img src="/app/icon.png" alt="" width="96" height="96" class="cta-icon" />
    <h2 set:html={phrased(t.cta.title)} />
    <p>{t.cta.sub}</p>
    <a href={APP_STORE_URL} class="store" target="_blank" rel="noopener">
      <img src="/badge-app-store.svg" alt="Download on the App Store" width="156" height="52" />
    </a>
  </section>
</main>

<style>
  .home { background: var(--paper); color: var(--ink); }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .text-link {
    display: inline-block;
    font-weight: 500;
    color: var(--accent-ink);
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .text-link:hover { color: var(--ink); }

  .store { display: inline-block; }
  .store img { display: block; height: 52px; width: auto; }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 3rem;
    align-items: center;
    padding-top: calc(64px + 4.5rem);
    padding-bottom: 6rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.6rem, 5.4vw, 4.3rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 13ch;
    text-wrap: balance;
  }

  /* Languages with long compound words need a wider headline to avoid four lines */
  :global(html[lang="de"]) h1, :global(html[lang="nl"]) h1, :global(html[lang="fi"]) h1 { max-width: 16ch; }
  :global(html[lang="ja"]) h1, :global(html[lang="ko"]) h1, :global(html[lang="el"]) h1 { max-width: 11em; font-size: clamp(2.2rem, 4.4vw, 3.4rem); line-height: 1.2; }
  :global(html[lang="ja"]) h2, :global(html[lang="ko"]) h2 { line-height: 1.3; }

  .hero-sub {
    margin: 1.5rem 0 2.25rem;
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 30rem;
  }

  .hero-note {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .hero-media {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .hero-media :global(.hero-back) {
    width: 46%;
    max-width: 265px;
    margin-right: -9%;
    transform: translateY(-2.5rem);
  }

  .hero-media :global(.hero-front) {
    width: 53%;
    max-width: 310px;
    position: relative;
  }

  /* Product sections */
  .features { padding-bottom: 7rem; }
  .features > :global(* + *) { margin-top: 8rem; }

  .features :global(.one) { width: 300px; max-width: 72%; }
  .home :global(.two) { width: 260px; max-width: 46%; }
  .home :global(.two-low) { transform: translateY(2.5rem); }

  .band {
    background: var(--sand);
    padding: 6rem 0 7rem;
  }

  /* Roasters */
  .roasters { padding-top: 7rem; }

  .section-head { max-width: 38rem; }
  .section-head p {
    margin: 1rem 0 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .logo-wall {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2.5rem;
  }

  .logo-wall img {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
    object-fit: contain;
  }

  /* More */
  .more { padding-top: 7rem; }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin-top: 2.25rem;
  }

  .more-item {
    padding: 1.5rem 0 1.75rem;
    border-top: 1px solid var(--line);
  }

  .more-item h3 { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.4rem; }
  .more-item p { font-size: 0.97rem; line-height: 1.65; color: var(--ink-2); }

  /* Pricing */
  .pricing { padding-top: 7rem; }

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2.25rem;
  }

  .plan {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 2rem 2rem 2.25rem;
  }

  .plan h3 { font-family: var(--font-serif); font-weight: 600; font-size: 1.6rem; letter-spacing: -0.01em; }
  .plan-sub { font-size: 0.92rem; color: var(--ink-3); margin: 0.2rem 0 1.5rem; }

  .plan ul { list-style: none; display: grid; gap: 0.7rem; }
  .plan li { display: flex; gap: 0.65rem; align-items: flex-start; font-size: 0.98rem; line-height: 1.5; }
  .plan svg { flex: none; width: 16px; height: 16px; margin-top: 0.2rem; color: var(--accent); }

  .plan-pro { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .plan-pro .plan-sub { color: rgba(250, 247, 242, 0.6); }
  .plan-pro svg { color: #E2A866; }

  .pricing-note { margin-top: 1.25rem; font-size: 0.9rem; color: var(--ink-3); }

  /* FAQ */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 3rem;
    padding-top: 7rem;
  }

  .faq-list { border-top: 1px solid var(--line); }

  details { border-bottom: 1px solid var(--line); }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    font-size: 1.05rem;
    font-weight: 500;
  }

  summary::-webkit-details-marker { display: none; }

  summary::after {
    content: '+';
    flex: none;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--ink-3);
    transition: transform 0.2s;
  }

  details[open] summary::after { transform: rotate(45deg); }

  details p {
    padding: 0 2rem 1.25rem 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  /* Guides */
  .guides { padding-top: 7rem; }

  .guide-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 0.75rem;
  }

  .guide {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.2s;
  }

  .guide:hover { border-color: var(--ink-3); }
  .guide-title { font-weight: 600; font-size: 1.05rem; line-height: 1.35; flex: 1; }
  .guide-time { font-size: 0.85rem; color: var(--ink-3); }

  .guide-links { display: flex; gap: 1.75rem; margin-top: 1.5rem; }

  /* Closing */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 8rem;
    padding-bottom: 8rem;
  }

  .cta-icon { border-radius: 22.5%; box-shadow: 0 1px 2px rgba(28, 26, 23, 0.1), 0 8px 24px -8px rgba(28, 26, 23, 0.25); margin-bottom: 1.75rem; }
  .cta p { margin: 0.75rem 0 2rem; font-size: 1.0625rem; color: var(--ink-2); }

  @media (max-width: 860px) {
    .wrap { padding: 0 1rem; }
    .hero { grid-template-columns: minmax(0, 1fr); padding-top: calc(64px + 2.5rem); padding-bottom: 4rem; gap: 3rem; }
    .features { padding-bottom: 5rem; }
    .features > :global(* + *) { margin-top: 5.5rem; }
    .band { padding: 4.5rem 0 5.5rem; }
    .roasters, .more, .pricing, .guides { padding-top: 5rem; }
    .more-grid, .plans, .guide-list { grid-template-columns: minmax(0, 1fr); }
    .faq { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding-top: 5rem; }
    .logo-wall { gap: 8px; }
    .logo-wall img { width: 48px; height: 48px; border-radius: 10px; }
    .cta { padding-top: 5.5rem; padding-bottom: 5.5rem; }
  }
</style>
