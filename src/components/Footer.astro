---
import locales from '../data/i18n/locales.json';
import home from '../data/i18n/home.json';

interface Props {
  /** Set on localized landing pages: hides links that only exist in English. */
  locale?: string;
}

const { locale } = Astro.props;
const localized = Boolean(locale);
const strings = (home as Record<string, any>)[locale ?? 'en'];
const f = strings.footer;
const n = strings.nav;
const base = localized ? `/${locale}/` : '/';

// Plain anchors, not the switcher's <select>: crawlers don't follow option values,
// so without these the localized pages have no internal links pointing at them.
const languages = [
  { hreflang: 'en', native: 'English', href: '/' },
  ...Object.entries(locales as Record<string, any>).map(([code, l]) => ({
    hreflang: l.meta.hreflang,
    native: l.meta.native,
    href: `/${code}/`,
  })),
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-cols">
      <div class="footer-brand">
        <a href={base} class="footer-logo">
          <img src="/app/icon.png" alt="" width="28" height="28" />
          <span>Brewio</span>
        </a>
        <p>{f.desc}</p>
      </div>

      <div class="footer-col">
        <h2>{f.app}</h2>
        <a href={`${base}#features`}>{n.features}</a>
        <a href={`${base}#pricing`}>{n.pricing}</a>
        <a href="/roasters/">{n.roasters}</a>
        <a href={`${base}#faq`}>{f.faq}</a>
      </div>

      {!localized && (
        <div class="footer-col">
          <h2>{f.learn}</h2>
          <a href="/guides/">{n.guides}</a>
          <a href="/tools/">{n.tools}</a>
        </div>
      )}

      <div class="footer-col">
        <h2>{f.legal}</h2>
        <a href="/privacy/">{f.privacy}</a>
        <a href="/terms/">{f.terms}</a>
        <a href="/privacy/#cookies" data-cookie-settings>{f.cookies}</a>
        <a href="mailto:hello@brewio.app">hello@brewio.app</a>
      </div>
    </div>

    <nav class="footer-langs" aria-label={f.languages}>
      {languages.map((l) => (
        <a href={l.href} hreflang={l.hreflang} lang={l.hreflang}>{l.native}</a>
      ))}
    </nav>

    <p class="footer-copy">&copy; 2026 Brewio</p>
  </div>
</footer>

<style>
  .footer {
    background: #1C1A17;
    color: rgba(250, 247, 242, 0.62);
    padding: 4rem 1.5rem 2.5rem;
  }

  .footer-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(250, 247, 242, 0.1);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: #FAF7F2;
  }

  .footer-logo img { border-radius: 7px; }

  .footer-brand p {
    margin-top: 0.85rem;
    max-width: 18rem;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .footer-col { display: flex; flex-direction: column; gap: 0.55rem; }

  .footer-col h2 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: #FAF7F2;
    margin-bottom: 0.35rem;
  }

  .footer-col a, .footer-langs a {
    font-size: 0.92rem;
    transition: color 0.15s;
  }

  .footer-col a:hover, .footer-langs a:hover { color: #FAF7F2; }

  .footer-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 1.75rem 0;
  }

  .footer-langs a { font-size: 0.85rem; }

  .footer-copy { font-size: 0.85rem; color: rgba(250, 247, 242, 0.4); }

  @media (max-width: 760px) {
    .footer { padding: 3rem 1rem 2rem; }
    .footer-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>
