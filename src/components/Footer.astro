---
import locales from '../data/i18n/locales.json';

interface Props {
  /** Set on localized landing pages — hides links that only exist in English. */
  locale?: string;
}

const { locale } = Astro.props;
const localized = Boolean(locale);

// Plain anchors, not the switcher's <select>: crawlers don't follow option values,
// so without these the localized pages have no internal links pointing at them.
const languages = [
  { hreflang: 'en', native: 'English', href: '/' },
  ...Object.entries(locales as Record<string, any>).map(([code, l]) => ({
    hreflang: l.meta.hreflang,
    native: l.meta.native,
    href: `/${code}/`,
  })),
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-logo-circle">
          <img src="/brewio-logo.png" alt="Brewio" class="footer-logo-img" />
        </div>
      </div>
      <p class="footer-tagline">"Every cup tells a story."</p>
    </div>

    <div class="footer-divider"></div>

    <nav class="footer-langs" aria-label="Languages">
      {languages.map((l) => (
        <a href={l.href} hreflang={l.hreflang} lang={l.hreflang}>{l.native}</a>
      ))}
    </nav>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; 2026 Brewio. All rights reserved.</p>
      <div class="footer-links">
        {!localized && (
          <>
            <a href="/tools/">Tools</a>
            <a href="/guides/">Guides</a>
            <a href="/roasters/">Roasters</a>
          </>
        )}
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
        <a href="mailto:hello@brewio.app">Contact</a>
        <a href="/privacy/#cookies" data-cookie-settings>Cookie settings</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0F0D0C;
    padding: 3rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--amber);
  }

  .footer-logo-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #F9F5EF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    opacity: 0.85;
  }

  .footer-logo-img {
    height: 20px;
    width: auto;
    display: block;
  }

  .footer-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
    color: rgba(250, 247, 242, 0.25);
  }

  .footer-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.05);
    margin-bottom: 2rem;
  }

  .footer-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 2rem;
  }

  .footer-langs a {
    font-size: 0.75rem;
    color: rgba(250, 247, 242, 0.3);
    transition: color 0.2s;
  }

  .footer-langs a:hover {
    color: rgba(250, 247, 242, 0.65);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.78rem;
    color: rgba(250, 247, 242, 0.2);
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-links a {
    font-size: 0.78rem;
    color: rgba(250, 247, 242, 0.3);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: rgba(250, 247, 242, 0.65);
  }

  @media (max-width: 600px) {
    .footer-top {
      flex-direction: column;
      text-align: center;
    }

    .footer-langs {
      justify-content: center;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-links {
      gap: 1.25rem;
    }
  }
</style>
