---
import { GUIDES } from '../data/guides';

const FEATURED = ['coffee-to-water-ratio', 'espresso-for-beginners', 'coffee-grind-size-chart'];
const featured = FEATURED.map((slug) => GUIDES.find((g) => g.slug === slug)!);
---

<section class="guides-teaser">
  <div class="gt-inner">
    <div class="gt-header">
      <div>
        <div class="section-eyebrow">From the Brewio Guides</div>
        <h2 class="section-heading">Brew <em>smarter.</em></h2>
        <p class="section-sub">
          In-depth guides on technique, science, and flavour — everything
          you need to get more out of every cup.
        </p>
      </div>
      <a href="/guides/" class="gt-view-all">
        View all guides
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <div class="gt-grid">
      {featured.map(g => (
        <a href={`/guides/${g.slug}/`} class="gt-card">
          <div class="gt-meta">
            <span class="gt-category">{g.category}</span>
            <span class="gt-dot">·</span>
            <span class="gt-read">{g.readTime}</span>
          </div>
          <h3 class="gt-title">{g.title}</h3>
          <p class="gt-desc">{g.desc}</p>
          <span class="gt-link">
            Read guide
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .guides-teaser {
    background: var(--dark-surface);
    padding: 7rem 2rem;
  }

  .gt-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .gt-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    gap: 2rem;
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--amber);
    margin-bottom: 0.875rem;
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 3rem);
    color: var(--cream);
    letter-spacing: -0.025em;
    margin-bottom: 0.875rem;
    line-height: 1.1;
  }

  .section-heading em {
    color: var(--amber);
    font-style: italic;
  }

  .section-sub {
    font-size: 1rem;
    color: rgba(250,247,242,0.45);
    max-width: 420px;
    line-height: 1.7;
  }

  .gt-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--amber);
    background: rgba(196,123,48,0.1);
    border: 1px solid rgba(196,123,48,0.22);
    padding: 0.6rem 1.25rem;
    border-radius: 100px;
    transition: background 0.2s, transform 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .gt-view-all svg { width: 16px; height: 16px; transition: transform 0.2s; }

  .gt-view-all:hover {
    background: rgba(196,123,48,0.18);
    transform: translateY(-1px);
  }

  .gt-view-all:hover svg { transform: translateX(3px); }

  /* ── Grid ── */
  .gt-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .gt-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 20px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.22s, border-color 0.22s, transform 0.22s;
    cursor: pointer;
  }

  .gt-card:hover {
    background: rgba(196,123,48,0.07);
    border-color: rgba(196,123,48,0.22);
    transform: translateY(-4px);
  }

  .gt-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
  }

  .gt-category {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--amber);
    background: rgba(196,123,48,0.09);
    border: 1px solid rgba(196,123,48,0.18);
    padding: 0.15rem 0.55rem;
    border-radius: 100px;
    font-size: 0.62rem;
  }

  .gt-dot { color: rgba(250,247,242,0.2); }
  .gt-read { color: rgba(250,247,242,0.35); }

  .gt-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--cream);
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .gt-desc {
    font-size: 0.88rem;
    color: rgba(250,247,242,0.4);
    line-height: 1.7;
  }

  .gt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--amber);
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .gt-link svg { width: 14px; height: 14px; transition: transform 0.2s; }

  .gt-card:hover .gt-link svg { transform: translateX(3px); }

  @media (max-width: 900px) {
    .gt-grid { grid-template-columns: 1fr; }
    .gt-header { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 580px) {
    .guides-teaser { padding: 5rem 1.25rem; }
    .gt-card { padding: 1.25rem; }
  }
</style>
