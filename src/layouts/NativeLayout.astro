---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { phrased } from '../components/home/phrase';
import { SITE_URL, APP_STORE_URL, OG_IMAGE, ORGANIZATION } from '../data/site';
import locales from '../data/i18n/locales.json';
import home from '../data/i18n/home.json';
import { NATIVE_PAGES, findPage, pagesFor } from '../data/i18n/native-pages';

interface Props {
  locale: string;
  slug: string;
  headline: string;
  subtitle: string;
  /** What Brewio does for this exact task, written in the page's language. */
  appNote: string;
}

const { locale, slug, headline, subtitle, appNote } = Astro.props;

const UPDATED = '2026-10-11';

const all = locales as Record<string, any>;
const t = all[locale];
const h = (home as Record<string, any>)[locale];
const page = findPage(locale, slug);
const updated = page.updated ?? UPDATED;
const lang = page.lang ?? t.meta.hreflang;
const canonicalUrl = `${SITE_URL}/${locale}/${slug}/`;
const others = pagesFor(locale).filter((p) => p.slug !== slug);

const alternates = page.cluster
  ? NATIVE_PAGES.filter((p) => p.cluster === page.cluster).map((p) => ({
      hreflang: p.lang ?? all[p.locale].meta.hreflang,
      href: `${SITE_URL}/${p.locale}/${p.slug}/`,
    }))
  : undefined;

const headlineText = headline.replace(/<[^>]+>/g, '');
// Headlines used to carry an accent word in <em>; the new design sets them in one style.
const plainHeadline = headline.replace(/<\/?em>/g, '');

const main =
  page.kind === 'tool'
    ? {
        '@type': 'WebApplication',
        name: headlineText,
        description: page.description,
        url: canonicalUrl,
        applicationCategory: 'UtilitiesApplication',
        operatingSystem: 'Any',
        browserRequirements: 'Requires JavaScript',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        isAccessibleForFree: true,
        publisher: ORGANIZATION,
        inLanguage: lang,
      }
    : {
        '@type': 'Article',
        headline: headlineText,
        description: page.description,
        image: OG_IMAGE,
        datePublished: updated,
        dateModified: updated,
        author: ORGANIZATION,
        publisher: ORGANIZATION,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
        inLanguage: lang,
      };

const schema = [
  main,
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Brewio', item: `${SITE_URL}/${locale}/` },
      { '@type': 'ListItem', position: 2, name: page.label, item: canonicalUrl },
    ],
  },
];
---

<Layout
  title={page.title}
  description={page.description}
  canonicalUrl={canonicalUrl}
  lang={lang}
  ogLocale={page.ogLocale ?? t.meta.ogLocale}
  ogType={page.kind === 'guide' ? 'article' : 'website'}
  updatedDate={updated}
  alternates={alternates}
  schema={schema}
>

  <Nav locale={locale} />

  <article class="native">
    <header class="hero">
      <p class="hero-meta"><a href={`/${locale}/`}>Brewio</a> <span aria-hidden="true">/</span> <span>{h.guides.title.replaceAll('|', '')}</span></p>
      <h1 class="hero-h1" set:html={plainHeadline} />
      <p class="hero-sub">{subtitle}</p>
    </header>

    <div class="body">
      <div class="native-content">
        <slot />
      </div>

      <aside class="cta">
        <img src="/app/icon.png" alt="" width="64" height="64" class="cta-icon" />
        <div class="cta-text">
          <h2 class="cta-h2" set:html={phrased(h.cta.title)} />
          <p class="cta-note">{appNote}</p>
        </div>
        <a href={APP_STORE_URL} class="store" target="_blank" rel="noopener">
          <img src="/badge-app-store.svg" alt="App Store" width="144" height="48" />
        </a>
      </aside>

      {others.length > 0 && (
        <nav class="more" aria-labelledby="more-heading">
          <h2 id="more-heading" class="more-heading" set:html={phrased(h.guides.title)} />
          <ul class="more-list">
            {others.map((p) => (
              <li>
                <a href={`/${p.locale}/${p.slug}/`} class="more-card">
                  <span class="more-title">{p.label}</span>
                  <span class="more-desc">{p.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>

  <Footer locale={locale} />
</Layout>

<style>
  .native { background: var(--paper); color: var(--ink); }

  .hero { max-width: 780px; margin: 0 auto; padding: calc(64px + 4rem) 1.5rem 2rem; }

  .hero-meta { font-size: 0.9rem; color: var(--ink-3); margin-bottom: 1rem; }
  .hero-meta a { color: var(--accent-ink); }
  .hero-meta a:hover { color: var(--ink); }

  .hero-h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.1rem;
    text-wrap: balance;
  }

  .hero-sub { font-size: 1.1rem; line-height: 1.75; color: var(--ink-2); }

  /* Japanese has no spaces, so lines break mid-phrase and strand a lone 「す。」.
     auto-phrase breaks at phrase boundaries where supported and is ignored elsewhere. */
  :global(html[lang="ja"]) .hero-h1,
  :global(html[lang="ja"]) .hero-sub,
  :global(html[lang="ja"]) .native-content :global(h2) {
    word-break: auto-phrase;
  }

  .body { padding: 1rem 1.5rem 6rem; }

  .native-content { max-width: 780px; margin: 0 auto; padding-top: 2.25rem; border-top: 1px solid var(--line); }

  .native-content :global(h2) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.45rem, 3vw, 1.75rem);
    color: var(--ink);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 3.25rem 0 1rem;
    text-wrap: balance;
  }

  .native-content :global(h3) {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.12rem;
    color: var(--ink);
    line-height: 1.4;
    margin: 2.25rem 0 0.6rem;
  }

  .native-content :global(p) { font-size: 1.04rem; color: var(--ink-2); line-height: 1.85; margin-bottom: 1.15rem; }
  .native-content :global(strong) { color: var(--ink); font-weight: 600; }

  .native-content :global(ul),
  .native-content :global(ol) { margin: 0.75rem 0 1.5rem 1.35rem; }

  .native-content :global(li) { font-size: 1.04rem; color: var(--ink-2); line-height: 1.8; margin-bottom: 0.45rem; }
  .native-content :global(li::marker) { color: var(--ink-3); }

  .native-content :global(a:not([class])) { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 3px; }
  .native-content :global(a:not([class]):hover) { color: var(--ink); }

  .native-content :global(.note) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .native-content :global(.table-wrap) { overflow-x: auto; margin: 1.25rem 0 1.75rem; }
  .native-content :global(table) { border-collapse: collapse; width: 100%; font-size: 0.95rem; }

  /* Only tables inside a scroll wrapper may be wider than a phone; the calculators' own tables must fit. */
  .native-content :global(.table-wrap table) { min-width: 30rem; }

  .native-content :global(th) {
    text-align: left;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-3);
    padding: 0 1rem 0.7rem 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .native-content :global(td) {
    padding: 0.8rem 1rem 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    vertical-align: top;
  }

  .native-content :global(td:first-child) { color: var(--ink); }
  .native-content :global(td.num) { font-variant-numeric: tabular-nums; color: var(--ink); }

  .cta {
    max-width: 780px;
    margin: 3.5rem auto 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .cta-icon { flex: none; border-radius: 22.5%; box-shadow: 0 1px 2px rgba(28, 26, 23, 0.1); }
  .cta-text { flex: 1; min-width: 0; }
  .cta-h2 { font-family: var(--font-serif); font-weight: 600; font-size: 1.3rem; line-height: 1.3; margin-bottom: 0.35rem; }
  .cta-note { font-size: 0.95rem; line-height: 1.65; color: var(--ink-2); }
  .store img { display: block; height: 48px; width: auto; }

  .more { max-width: 780px; margin: 3.5rem auto 0; padding-top: 2rem; border-top: 1px solid var(--line); }
  .more-heading { font-family: var(--font-serif); font-weight: 600; font-size: 1.4rem; margin-bottom: 1rem; }
  .more-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }

  .more-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.15s;
  }

  .more-card:hover { border-color: var(--ink-3); }
  .more-title { font-weight: 600; font-size: 1rem; color: var(--ink); }
  .more-desc { font-size: 0.9rem; line-height: 1.55; color: var(--ink-2); }

  @media (max-width: 640px) {
    .hero { padding: calc(64px + 2.5rem) 1rem 1.5rem; }
    .body { padding: 0.5rem 1rem 4.5rem; }
    .cta { flex-direction: column; align-items: flex-start; }
  }
</style>
