---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, OG_IMAGE, ORGANIZATION, APP_STORE_URL } from '../data/site';
import { PUBLISHED, UPDATED, relatedGuides } from '../data/guides';

interface Props {
  title: string;
  description: string;
  headline: string;
  subtitle: string;
  heroAccent?: string;
  readTime: string;
  publishDate?: string;
  updatedDate?: string;
  category: string;
}

const {
  title,
  description,
  headline,
  subtitle,
  heroAccent = 'ratio',
  readTime,
  publishDate = PUBLISHED,
  updatedDate = UPDATED,
  category,
} = Astro.props;

const slug = Astro.url.pathname.replace(/^\/guides\//, '').replace(/\/$/, '');
const canonicalUrl = `${SITE_URL}/guides/${slug}/`;
const related = relatedGuides(slug);

// Headlines used to carry an italic accent word; the new design sets them in one style.
const plainHeadline = headline.replace(/<\/?em>/g, '');

const updatedLabel = new Date(updatedDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schema = [
  {
    '@type': 'Article',
    headline: title,
    description,
    image: OG_IMAGE,
    datePublished: publishDate,
    dateModified: updatedDate,
    author: ORGANIZATION,
    publisher: ORGANIZATION,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    articleSection: category,
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/guides/` },
      { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
    ],
  },
];
---

<Layout
  title={`${title} | Brewio`}
  description={description}
  canonicalUrl={canonicalUrl}
  ogType="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  schema={schema}
>
  <Nav />

  <article class="guide">
    <header class="guide-hero">
      <p class="hero-meta">
        <a href="/guides/">Guides</a>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
        <span aria-hidden="true">·</span>
        <span>{readTime} read</span>
        <span aria-hidden="true">·</span>
        <time datetime={updatedDate}>Updated {updatedLabel}</time>
      </p>
      <h1 class="hero-headline" set:html={plainHeadline} />
      <p class="hero-subtitle">{subtitle}</p>
    </header>

    <div class="guide-body">
      <div class="guide-content">
        <slot />
      </div>

      {related.length > 0 && (
        <nav class="related" aria-labelledby="related-heading">
          <h2 id="related-heading" class="related-heading">Keep reading</h2>
          <ul class="related-list">
            {related.map((g) => (
              <li>
                <a href={`/guides/${g.slug}/`} class="related-card">
                  <span class="related-category">{g.category}</span>
                  <span class="related-title">{g.title}</span>
                  <span class="related-desc">{g.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <aside class="guide-cta">
        <img src="/app/icon.png" alt="" width="64" height="64" class="cta-icon" />
        <div class="cta-text">
          <h2 class="cta-heading">Try it with Brewio</h2>
          <p>The app has a step-by-step brew timer, a ratio calculator and a journal for every cup you make. Free on iPhone.</p>
        </div>
        <a href={APP_STORE_URL} class="cta-store" target="_blank" rel="noopener">
          <img src="/badge-app-store.svg" alt="Download on the App Store" width="144" height="48" />
        </a>
      </aside>
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .guide { background: var(--paper); color: var(--ink); }

  .guide-hero {
    max-width: 760px;
    margin: 0 auto;
    padding: calc(64px + 4rem) 1.5rem 2.5rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .hero-meta a { color: var(--accent-ink); }
  .hero-meta a:hover { color: var(--ink); }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.2rem, 4.4vw, 3.3rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .guide-body { padding: 1.5rem 1.5rem 6rem; }

  .guide-content {
    max-width: 760px;
    margin: 0 auto;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .guide-content :global(h2) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.75rem;
    color: var(--ink);
    letter-spacing: -0.015em;
    margin: 3.25rem 0 1rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .guide-content :global(h3) {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--ink);
    margin: 2.25rem 0 0.6rem;
    line-height: 1.35;
  }

  .guide-content :global(p) {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .guide-content :global(strong) { color: var(--ink); font-weight: 600; }

  .guide-content :global(a) { color: var(--accent-ink); border-bottom: 1px solid currentColor; }
  .guide-content :global(a:hover) { color: var(--ink); }

  .guide-content :global(ul), .guide-content :global(ol) { margin: 1rem 0 1.5rem 1.25rem; }

  .guide-content :global(li) {
    font-size: 1.0625rem;
    color: var(--ink-2);
    line-height: 1.75;
    margin-bottom: 0.5rem;
  }

  .related {
    max-width: 760px;
    margin: 4.5rem auto 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .related-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.015em;
    margin-bottom: 1.25rem;
  }

  .related-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.15s;
  }

  .related-card:hover { border-color: var(--ink-3); }
  .related-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .related-category { font-size: 0.82rem; color: var(--ink-3); }
  .related-title { font-weight: 600; font-size: 1rem; line-height: 1.35; color: var(--ink); }
  .related-desc { font-size: 0.9rem; line-height: 1.55; color: var(--ink-2); }

  .guide-cta {
    max-width: 760px;
    margin: 4rem auto 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .cta-icon { flex: none; border-radius: 22.5%; box-shadow: 0 1px 2px rgba(28, 26, 23, 0.1); }
  .cta-text { flex: 1; min-width: 0; }

  .cta-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }

  .cta-text p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-2); }
  .cta-store img { display: block; height: 48px; width: auto; }

  @media (max-width: 640px) {
    .guide-hero { padding: calc(64px + 2.5rem) 1rem 2rem; }
    .guide-body { padding: 1rem 1rem 4.5rem; }
    .guide-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
