---
import { SITE_URL, OG_IMAGE, APP_STORE_URL, ORGANIZATION, GA_MEASUREMENT_ID } from '../data/site';
import locales from '../data/i18n/locales.json';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  publishDate?: string;
  updatedDate?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** Page language. Defaults to English. */
  lang?: string;
  ogLocale?: string;
  /** Emit the hreflang cluster (the localized landing pages + English home). */
  hreflangCluster?: boolean;
  /** An explicit hreflang set, for page clusters other than the landing pages. */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title = 'Brewio: coffee journal and brew timer for iPhone',
  description = 'Brewio is a coffee journal for iPhone. Log your brews, follow recipes with a step-by-step timer, keep track of your beans and see what you like. Free, in 15 languages.',
  canonicalUrl,
  ogType = 'website',
  publishDate,
  updatedDate,
  noindex = false,
  schema,
  lang = 'en',
  ogLocale = 'en_US',
  hreflangCluster = false,
  alternates: explicitAlternates,
} = Astro.props;

// GitHub Pages 301s the bare path to the trailing-slash URL, so a canonical without
// the slash points at a redirect. Derive it here rather than trusting each page.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = canonicalUrl ?? `${SITE_URL}${path}`;

const defaultSchema = [
  {
    '@type': 'MobileApplication',
    name: 'Brewio',
    description,
    url: `${SITE_URL}/`,
    downloadUrl: APP_STORE_URL,
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'iOS',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: ORGANIZATION,
  },
  ORGANIZATION,
];

// Landing pages form one hreflang cluster: English home + every localized page.
const alternates = hreflangCluster
  ? [
      { hreflang: 'x-default', href: `${SITE_URL}/` },
      { hreflang: 'en', href: `${SITE_URL}/` },
      ...Object.entries(locales as Record<string, any>).map(([code, l]) => ({
        hreflang: l.meta.hreflang,
        href: `${SITE_URL}/${code}/`,
      })),
    ]
  : explicitAlternates ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': schema ?? defaultSchema,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Brewio" />
    <meta property="og:locale" content={ogLocale} />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content="Brewio, a coffee journal and brew timer for iPhone" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <!-- Self-hosted copies of the Google Fonts files, so no visitor IP goes to Google -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <slot />

    {GA_MEASUREMENT_ID && (
      <div id="consent" class="consent" hidden>
        <p class="consent-text">
          We use Google Analytics to understand which guides people find useful.
          Nothing is collected unless you agree.
        </p>
        <div class="consent-actions">
          <button type="button" id="consent-decline" class="consent-btn">Decline</button>
          <button type="button" id="consent-accept" class="consent-btn consent-btn-primary">Accept</button>
        </div>
      </div>
      <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
        (function () {
          var KEY = 'brewio-consent';
          var banner = document.getElementById('consent');

          function loadAnalytics() {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            function gtag() { window.dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
          }

          function clearAnalyticsCookies() {
            var host = location.hostname;
            document.cookie.split(';').forEach(function (c) {
              var name = c.split('=')[0].trim();
              if (name.indexOf('_ga') !== 0) return;
              [host, '.' + host, '.' + host.replace(/^www\./, '')].forEach(function (d) {
                document.cookie = name + '=; Max-Age=0; path=/; domain=' + d;
              });
              document.cookie = name + '=; Max-Age=0; path=/';
            });
          }

          function decide(value) {
            try { localStorage.setItem(KEY, value); } catch (e) {}
            if (banner) banner.hidden = true;
            if (value === 'granted') {
              if (!window.gtag) loadAnalytics();
              return;
            }
            clearAnalyticsCookies();
            // Withdrawn after accepting: reload so the running tag stops too
            if (window.gtag) location.reload();
          }

          var stored = null;
          try { stored = localStorage.getItem(KEY); } catch (e) {}

          if (banner) {
            document.getElementById('consent-accept').addEventListener('click', function () { decide('granted'); });
            document.getElementById('consent-decline').addEventListener('click', function () { decide('denied'); });
            document.querySelectorAll('[data-cookie-settings]').forEach(function (link) {
              link.addEventListener('click', function (e) { e.preventDefault(); banner.hidden = false; });
            });
          }

          if (stored === 'granted') {
            loadAnalytics();
          } else if (stored !== 'denied' && banner) {
            banner.hidden = false;
          }
        })();
      </script>
    )}
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --cream: #FAF7F2;
    --cream-subtle: #F5F0E8;
    --dark: #1A1714;
    --dark-surface: #1E1B18;
    --dark-card: #2C2720;
    --brown: #6B3A1F;
    --amber: #C47B30;
    --amber-light: #D4904A;
    --amber-glow: rgba(196, 123, 48, 0.15);
    --text-dark: #2C2C2A;
    --text-muted: #888780;
    --text-light: #B4B2A9;
    --border: #D3D1C7;
    --border-subtle: #F0EDE8;
    --border-dark: #3A342E;

    /* Landing page palette: paper, ink and one accent */
    --paper: #FAF7F2;
    --surface: #FFFFFF;
    --sand: #F1E7D8;
    --ink: #1C1A17;
    --ink-2: #57524A;
    --ink-3: #8A847A;
    --line: #E6E0D6;
    --accent: #C47B30;
    --accent-ink: #94551A;

    --font-sans: 'DM Sans', system-ui, sans-serif;
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-mono: 'DM Mono', 'Courier New', monospace;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
    background: var(--paper);
  }

  body {
    font-family: var(--font-sans);
    background: var(--cream);
    color: var(--text-dark);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  /* Japanese and Korean don't use italics for emphasis: a synthesised slant on
     Mincho/Myeongjo reads as a rendering fault. Let colour carry it instead.
     Playfair stays first in the stack so Latin words keep the brand face. */
  html[lang="ja"] {
    --font-serif: 'Playfair Display', 'Hiragino Mincho ProN', 'Yu Mincho', 'Noto Serif JP', serif;
  }

  html[lang="ko"] {
    --font-serif: 'Playfair Display', 'Apple SD Gothic Neo', 'Noto Serif KR', serif;
  }

  /* Korean wraps at any character by default, which splits words like 이야기
     across lines. keep-all restricts breaks to spaces, as Korean typography expects. */
  html[lang="ko"] {
    word-break: keep-all;
  }

  /* Unbreakable phrase in a Japanese heading (see components/home/phrase.ts) */
  .ph { display: inline-block; }

  .consent {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 200;
    max-width: 30rem;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.125rem 1.25rem;
    background: var(--dark);
    border: 1px solid var(--border-dark);
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(26, 23, 20, 0.28);
  }

  .consent[hidden] { display: none; }

  .consent-text {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-light);
  }

  .consent-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  .consent-btn {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.5rem 1.125rem;
    border-radius: 100px;
    border: 1px solid var(--border-dark);
    background: transparent;
    color: var(--text-light);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, opacity 0.2s;
  }

  .consent-btn:hover { color: var(--cream); border-color: var(--text-muted); }

  .consent-btn-primary {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--dark);
  }

  .consent-btn-primary:hover { opacity: 0.9; color: var(--dark); border-color: var(--amber); }

  .consent-btn:focus-visible {
    outline: 2px solid var(--amber-light);
    outline-offset: 2px;
  }
</style>
