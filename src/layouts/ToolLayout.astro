---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, OG_IMAGE, ORGANIZATION, APP_STORE_URL } from '../data/site';
import { otherTools } from '../data/tools';

interface Props {
  title: string;
  description: string;
  headline: string;
  subtitle: string;
  slug: string;
  /** Guides that genuinely explain the theory behind this tool. */
  relatedGuides?: { slug: string; label: string }[];
}

const { title, description, headline, subtitle, slug, relatedGuides = [] } = Astro.props;

const canonicalUrl = `${SITE_URL}/tools/${slug}/`;
// Headlines used to carry an italic accent word; the new design sets them in one style.
const plainHeadline = headline.replace(/<\/?em>/g, '');
const others = otherTools(slug);

const schema = [
  {
    '@type': 'WebApplication',
    name: title,
    description,
    url: canonicalUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    publisher: ORGANIZATION,
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE_URL}/tools/` },
      { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
    ],
  },
];
---

<Layout
  title={`${title} | Brewio`}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
>
  <Nav />

  <article class="tool">
    <header class="tool-hero">
      <p class="hero-meta"><a href="/tools/">Tools</a></p>
      <h1 class="hero-headline" set:html={plainHeadline} />
      <p class="hero-subtitle">{subtitle}</p>
    </header>

    <div class="tool-body">
      <div class="tool-inner">
        <slot />

        {relatedGuides.length > 0 && (
          <section class="theory">
            <h2 class="section-heading">The theory behind it</h2>
            <ul class="theory-list">
              {relatedGuides.map((g) => (
                <li>
                  <a href={`/guides/${g.slug}/`}>
                    {g.label}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <aside class="tool-cta">
          <img src="/app/icon.png" alt="" width="64" height="64" class="cta-icon" />
          <div class="cta-text">
            <h2 class="cta-heading">This is in the Brewio app too</h2>
            <p>Next to a journal that keeps what you brewed, how it tasted and which beans are worth buying again. Free on iPhone.</p>
          </div>
          <a href={APP_STORE_URL} class="cta-store" target="_blank" rel="noopener">
            <img src="/badge-app-store.svg" alt="Download on the App Store" width="144" height="48" />
          </a>
        </aside>

        <nav class="more-tools" aria-labelledby="more-tools-heading">
          <h2 id="more-tools-heading" class="section-heading">More free tools</h2>
          <ul class="more-list">
            {others.map((t) => (
              <li>
                <a href={`/tools/${t.slug}/`} class="more-card">
                  <span class="more-icon" set:html={t.icon}></span>
                  <span class="more-title">{t.title}</span>
                  <span class="more-desc">{t.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .tool { background: var(--paper); color: var(--ink); }

  .tool-hero {
    max-width: 820px;
    margin: 0 auto;
    padding: calc(64px + 4rem) 1.5rem 2rem;
  }

  .hero-meta { font-size: 0.9rem; margin-bottom: 1rem; }
  .hero-meta a { color: var(--accent-ink); }
  .hero-meta a:hover { color: var(--ink); }

  .hero-headline {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.2rem, 4.4vw, 3.3rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
    margin-bottom: 1.1rem;
  }

  .hero-subtitle { font-size: 1.15rem; line-height: 1.65; color: var(--ink-2); max-width: 38rem; }

  .tool-body { padding: 1rem 1.5rem 6rem; }
  .tool-inner { max-width: 820px; margin: 0 auto; }

  .section-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.015em;
    margin-bottom: 1rem;
  }

  .theory { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }

  .theory-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }

  .theory-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 0.97rem;
    color: var(--ink);
    transition: border-color 0.15s;
  }

  .theory-list a:hover { border-color: var(--ink-3); }
  .theory-list a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theory-list svg { width: 16px; height: 16px; color: var(--accent-ink); flex-shrink: 0; }

  .tool-cta {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .cta-icon { flex: none; border-radius: 22.5%; box-shadow: 0 1px 2px rgba(28, 26, 23, 0.1); }
  .cta-text { flex: 1; min-width: 0; }

  .cta-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
  }

  .cta-text p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-2); }
  .cta-store img { display: block; height: 48px; width: auto; }

  .more-tools { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }

  .more-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .more-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.15s;
  }

  .more-card:hover { border-color: var(--ink-3); }
  .more-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .more-icon { display: block; width: 22px; height: 22px; color: var(--accent-ink); }
  .more-icon :global(svg) { width: 100%; height: 100%; }
  .more-title { font-weight: 600; font-size: 1rem; color: var(--ink); }
  .more-desc { font-size: 0.9rem; line-height: 1.55; color: var(--ink-2); }

  @media (max-width: 640px) {
    .tool-hero { padding: calc(64px + 2.5rem) 1rem 1.5rem; }
    .tool-body { padding: 0.5rem 1rem 4.5rem; }
    .tool-cta { flex-direction: column; align-items: flex-start; }
  }
</style>
